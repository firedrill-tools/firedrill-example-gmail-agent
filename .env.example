# The model key is required for the agent. Keep it in your shell or a local .env file.
ANTHROPIC_API_KEY=

# For the chat UI, obtain an MCP connection for your active synthetic Gmail
# instance with `firedrill tools connections create`. Simulations receive their
# own case-scoped connection automatically; never copy a manual token into tests.
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=

AGENT_MODEL=claude-sonnet-4-5
AGENT_AUTONOMY=read
PORT=4310
