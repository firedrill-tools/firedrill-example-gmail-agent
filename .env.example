# The model key is required for the agent. Keep it in your shell or a local .env file.
ANTHROPIC_API_KEY=

# For the chat UI, obtain these values with `npx firedrill connect` for your
# ready Gmail Tool setup. Do not use a real Gmail endpoint or commit credentials.
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=

AGENT_MODEL=claude-sonnet-4-5
AGENT_AUTONOMY=read
PORT=4310
