# The model key is required for the agent. Keep it in your shell or a local .env file.
ANTHROPIC_API_KEY=

# For the standalone chat UI, copy these two values from the local Firedrill
# "Connect agent" panel after running firedrill serve.
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=

AGENT_MODEL=claude-sonnet-4-5
AGENT_AUTONOMY=write
PORT=4310
