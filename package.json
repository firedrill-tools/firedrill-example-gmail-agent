{
  "name": "firedrill-example-gmail-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Agent SDK email assistant tested against a stateful synthetic Gmail Tool.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "npm run build:web && tsx src/server.ts",
    "dev": "concurrently -k -n agent,web \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "check": "npm run typecheck && npm run build:web",
    "drills": "node ../firedrill/packages/cli/dist/bin.js run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@firedrill-community/tool-gmail": "file:.firedrill-tools/a4cefb1295f8a71115441199f272781159046209aaa974ae4a3851c1275b3ef2.tgz",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
